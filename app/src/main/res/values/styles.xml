<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/xp_ui</item>
        <item name="android:colorAccent">#316AC5</item>
        <item name="android:editTextStyle">@style/XpEditText</item>
        <item name="android:spinnerStyle">@style/XpSpinner</item>
        <item name="android:spinnerItemStyle">@style/XpSpinnerItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/XpSpinnerDropdown</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#02070D</item>
        <item name="android:popupMenuStyle">@style/AeroPopupMenu</item>
        <item name="android:scrollbarThumbVertical">@drawable/aero_scroll_thumb</item>
        <item name="android:scrollbarTrackVertical">@drawable/aero_scroll_track</item>
        <item name="android:scrollbarSize">9dp</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="AeroPopupMenu" parent="android:style/Widget.Material.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/aero_popup</item>
    </style>
    <style name="XpEditText" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/xp_textbox</item><item name="android:backgroundTint">@null</item>
        <item name="android:padding">5dp</item><item name="android:minHeight">32dp</item><item name="android:textColor">#000000</item><item name="android:textColorHint">#777777</item><item name="android:textSize">12sp</item>
    </style>
    <style name="XpSpinner" parent="android:style/Widget.Material.Spinner">
        <item name="android:background">@drawable/xp_combobox</item><item name="android:backgroundTint">@null</item><item name="android:minHeight">32dp</item><item name="android:paddingStart">6dp</item><item name="android:paddingEnd">26dp</item><item name="android:popupBackground">@drawable/aero_popup</item>
    </style>
    <style name="XpSpinnerItem" parent="android:style/Widget.TextView.SpinnerItem"><item name="android:textSize">12sp</item><item name="android:checkMark">@null</item><item name="android:textColor">#000000</item><item name="android:fontFamily">@font/xp_ui</item></style>
    <style name="XpSpinnerDropdown" parent="android:style/Widget.DropDownItem.Spinner"><item name="android:textSize">12sp</item><item name="android:minHeight">36dp</item><item name="android:checkMark">@null</item><item name="android:textColor">#000000</item><item name="android:fontFamily">@font/xp_ui</item></style>
</resources>
